# meson.build hunk for src/panfrost/lib/kmod/meson.build
#
# Adds the kbase backend to libpanfrost_kmod. The kbase UAPI headers are not
# part of Mesa - they're vendored in the PanVK2KBase repo - so the include
# path has to be pointed at them explicitly.
#
# Set KBASE_UAPI_DIR to the vendored header set that matches the target
# kernel (see that repo's third_party/kbase-uapi-*/README.md). r49p1 is the
# one confirmed against a real device; r44p0 is also vendored.
#
# --- add to the libpanfrost_kmod sources list ---
#
#   'pan_kmod_kbase.c',
#
# --- add to its include_directories ---
#
#   include_directories(get_option('kbase-uapi-dir')),
#
# --- and declare the option in Mesa's top-level meson_options.txt ---
#
#   option(
#     'kbase-uapi-dir',
#     type : 'string',
#     value : '',
#     description : 'Path to vendored Arm kbase UAPI headers (PanVK2KBase third_party/kbase-uapi-<ver>)'
#   )
#
# Note: pan_kmod_kbase.c also needs -DMALI_USE_CSF=1, matching every other
# consumer of these headers in the PanVK2KBase repo, and the kconfig shim
# (src/utils/kconfig_shim.h) if building against an MTK-derived header set
# that uses IS_ENABLED() - see that repo's makefile for the exact flags.
