<?xml version="1.0" encoding="utf-8"?>
<!-- A NativeActivity, so the app has no Java at all: android.app.lib_name
     names the .so whose android_main() the platform calls. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.panvk2kbase.swapchainapp">

    <!-- extractNativeLibs=true so the bundled driver lands in the app's
         native library directory as a real file. An app is always allowed to
         execute from there, which is not true of its own writable data dir
         under Android's W^X policy. -->
    <application android:label="PanVK kbase probe"
                 android:hasCode="false"
                 android:debuggable="true"
                 android:extractNativeLibs="true">

        <activity android:name="android.app.NativeActivity"
                  android:label="PanVK kbase probe"
                  android:exported="true"
                  android:configChanges="orientation|keyboardHidden|screenSize">

            <meta-data android:name="android.app.lib_name"
                       android:value="panvk_swapchain_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
